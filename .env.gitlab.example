# GitLab tooling credentials — copy to .env.gitlab (which is gitignored).
# SPECDOC §2: these go in .env.gitlab, NOT .env — a token in .env becomes a real
# env var inside every application container.
CR_GITLAB_URL=https://gitlab.example.com
CR_GITLAB_PROJECT=group/project
CR_GITLAB_TOKEN=<your PAT with scope: api>
