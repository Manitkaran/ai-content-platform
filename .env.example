# AI Content Platform — environment configuration.
#
# This file documents EVERY key the config layer (app/config.py) reads. A drift
# test (tests/test_config.py) fails if this file and app/config.py disagree in
# either direction. Copy to `.env` and edit for your deployment.

# App identity and environment: development | testing | production
ACP_APP_NAME=ai-content-platform
ACP_ENV=development

# --- Model seam (D13, D20) ---------------------------------------------------
# Driver: faster_whisper (real, default) | fake (test-only, deterministic).
ACP_MODEL_DRIVER=faster_whisper
# Model tier: tiny|base = fast/rough; small = balanced CPU default (CR-014). For
# BENGALI/HINDI/other non-English + heavy accents + names, small/base are weak — use
# large-v3 with a GPU (set ACP_MODEL_TIER=large-v3 and ACP_DEVICE=cuda). medium is
# better than small at Indic languages but slow on CPU. (CR-015)
ACP_MODEL_TIER=small
# Device: cpu (default) | cuda (GPU opt-in).
ACP_DEVICE=cpu

# --- Storage seam (D21) ------------------------------------------------------
# Driver: local (real disk, default) | fake (test-only; refused in production).
ACP_STORAGE_DRIVER=local
# Root directory for the local storage driver, the job DB, and volumes.
ACP_DATA_DIR=./data
# Job store / database URL (SQLite path or Postgres DSN).
ACP_DATABASE_URL=sqlite:///./data/acp.db

# --- Translate seam (CR-025 / D25) -------------------------------------------
# Arbitrary source->target machine translation, a post-transcription stage.
# Driver: argos (Argos Translate, offline & MIT, default) | fake (test-only, no
# model/download). Install argostranslate, then the needed language-pair package(s),
# e.g. English->Hindi (each pair is a separate ~100-300 MB download):
#   pip install argostranslate
#   python - <<'PY'
#   import argostranslate.package as p
#   p.update_package_index()
#   pkg = next(x for x in p.get_available_packages()
#              if x.from_code == "en" and x.to_code == "hi")
#   p.install_from_path(pkg.download())
#   PY
# Argos pivots through English when no direct from->to package is installed.
# A missing pair surfaces as a failed job / stream error, never a 500.
ACP_TRANSLATE_DRIVER=argos

# --- Limits & retention (D15, D16) -------------------------------------------
# Max upload size in bytes (CR-021: default 5 GB). Oversized uploads are rejected 413.
ACP_MAX_UPLOAD_BYTES=5368709120
# Max files accepted in one POST /transcribe/batch request (CR-019, default 20).
ACP_MAX_BATCH_FILES=20
# Max characters in a transcription prompt / template (CR-022, default 2000).
ACP_MAX_PROMPT_CHARS=2000
# Days a completed transcript is kept before the sweep deletes it (default 30).
ACP_TRANSCRIPT_RETENTION_DAYS=30

# --- Server ------------------------------------------------------------------
ACP_HOST=0.0.0.0
ACP_PORT=8000
